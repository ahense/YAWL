            </mapping>
            <mapping>
              <expression query="&lt;email&gt;{/Net/email/text()}&lt;/email&gt;" />
              <mapsTo>email</mapsTo>
            </mapping>
          </startingMappings>
          <resourcing>
            <offer initiator="system">
              <distributionSet>
                <initialSet />
              </distributionSet>
              <familiarParticipant taskID="Input_position_name" />
            </offer>
            <allocate initiator="system">
              <allocator>
                <name>RandomChoice</name>
              </allocator>
            </allocate>
            <start initiator="user" />
          </resourcing>
          <decomposesTo id="Show_info" />
        </task>
        <outputCondition id="OutputCondition" />
      </processControlElements>
