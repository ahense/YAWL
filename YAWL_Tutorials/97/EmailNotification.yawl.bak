<?xml version="1.0" encoding="UTF-8"?>
<specificationSet xmlns="http://www.yawlfoundation.org/yawlschema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" version="4.0" xsi:schemaLocation="http://www.yawlfoundation.org/yawlschema http://www.yawlfoundation.org/yawlschema/YAWL_Schema4.0.xsd">
  <specification uri="EmailNotification">
    <documentation>Email notification demo</documentation>
    <metaData>
      <title>Email notification</title>
      <creator>User</creator>
      <description>Email notification demo</description>
      <coverage>5.2.821</coverage>
      <version>0.1</version>
      <persistent>false</persistent>
      <identifier>UID_4347cb0f-b374-4e1e-809c-6e2557a4d9cc</identifier>
    </metaData>
    <xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" />
    <decomposition id="Net" isRootNet="true" xsi:type="NetFactsType">
      <localVariable>
        <index>0</index>
        <name>Advice</name>
        <type>string</type>
        <namespace>http://www.w3.org/2001/XMLSchema</namespace>
        <initialValue />
      </localVariable>
      <processControlElements>
        <inputCondition id="InputCondition">
          <flowsInto>
            <nextElementRef id="Give_advice" />
          </flowsInto>
        </inputCondition>
        <task id="Give_advice">
          <name>Give advice</name>
          <flowsInto>
            <nextElementRef id="OutputCondition" />
          </flowsInto>
          <join code="xor" />
          <split code="and" />
          <completedMappings>
            <mapping>
              <expression query="&lt;Advice&gt;{/Give_advice/Advice/text()}&lt;/Advice&gt;" />
              <mapsTo>Advice</mapsTo>
            </mapping>
          </completedMappings>
          <resourcing>
            <offer initiator="system">
              <distributionSet>
                <initialSet>
                  <role>RO-6c5c33df-364a-47ee-b4fb-ecd85cf3fcfe</role>
                </initialSet>
              </distributionSet>
            </offer>
            <allocate initiator="user" />
            <start initiator="user" />
          </resourcing>
          <decomposesTo id="Give_advice" />
        </task>
        <outputCondition id="OutputCondition" />
      </processControlElements>
    </decomposition>
    <decomposition id="Give_advice" xsi:type="WebServiceGatewayFactsType">
      <name>Give advice</name>
      <outputParam>
        <index>0</index>
        <name>Advice</name>
        <type>string</type>
        <namespace>http://www.w3.org/2001/XMLSchema</namespace>
        <defaultValue />
      </outputParam>
      <externalInteraction>manual</externalInteraction>
    </decomposition>
  </specification>
  <layout>
    <locale language="en" country="GB"/>
    <specification id="EmailNotification" defaultBgColor="-526351">
      <size w="799" h="642"/>
      <net id="Net" bgColor="-526351">
        <bounds x="0" y="0" w="1685" h="656"/>
        <frame x="0" y="0" w="1688" h="659"/>
        <viewport x="0" y="0" w="1688" h="659"/>
        <vertex id="OutputCondition">
          <attributes>
            <bounds x="380" y="112" w="32" h="32"/>
          </attributes>
        </vertex>
        <vertex id="InputCondition">
          <attributes>
            <bounds x="36" y="112" w="32" h="32"/>
          </attributes>
        </vertex>
        <container id="Give_advice">
          <vertex>
            <attributes>
              <bounds x="188" y="112" w="32" h="32"/>
            </attributes>
          </vertex>
          <label>
            <attributes>
              <bounds x="156" y="144" w="96" h="14"/>
            </attributes>
          </label>
        </container>
        <flow source="Give_advice" target="OutputCondition">
          <ports in="13" out="12"/>
          <attributes>
            <lineStyle>11</lineStyle>
            <points>
              <value x="243" y="127.5"/>
              <value x="444" y="123.5"/>
            </points>
          </attributes>
        </flow>
        <flow source="InputCondition" target="Give_advice">
          <ports in="13" out="12"/>
          <attributes>
            <lineStyle>11</lineStyle>
            <points>
              <value x="67" y="123.5"/>
              <value x="212" y="127.5"/>
            </points>
          </attributes>
        </flow>
      </net>
      <labelFontSize>12</labelFontSize>
    </specification>
  </layout>
</specificationSet>
