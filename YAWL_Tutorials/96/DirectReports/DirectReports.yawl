<?xml version="1.0" encoding="UTF-8"?>
<specificationSet xmlns="http://www.yawlfoundation.org/yawlschema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" version="4.0" xsi:schemaLocation="http://www.yawlfoundation.org/yawlschema http://www.yawlfoundation.org/yawlschema/YAWL_Schema4.0.xsd">
  <specification uri="DirectReports">
    <name>UsersWithRoles</name>
    <documentation>used to demo the direct reports codelet</documentation>
    <metaData>
      <title>DirectReports</title>
      <creator>AVH</creator>
      <description>used to demo the direct reports codelet</description>
      <coverage>5.2.821</coverage>
      <version>0.1</version>
      <persistent>false</persistent>
      <identifier>UID_b301d1a5-9311-4d9e-99f1-cfa255ae5322</identifier>
    </metaData>
    <xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" />
    <decomposition id="Net" isRootNet="true" xsi:type="NetFactsType">
      <localVariable>
        <index>0</index>
        <name>positionname</name>
        <type>string</type>
        <namespace>http://www.w3.org/2001/XMLSchema</namespace>
        <initialValue />
      </localVariable>
      <localVariable>
        <index>1</index>
        <name>directreportids</name>
        <type>string</type>
        <namespace>http://www.w3.org/2001/XMLSchema</namespace>
        <initialValue />
      </localVariable>
      <processControlElements>
        <inputCondition id="InputCondition">
          <flowsInto>
            <nextElementRef id="Input_position_name" />
          </flowsInto>
        </inputCondition>
        <task id="Input_position_name">
          <name>Input position name</name>
          <flowsInto>
            <nextElementRef id="DirectReports_codelet" />
          </flowsInto>
          <join code="xor" />
          <split code="and" />
          <completedMappings>
            <mapping>
              <expression query="&lt;positionname&gt;{/Input_position_name/positionname/text()}&lt;/positionname&gt;" />
              <mapsTo>positionname</mapsTo>
            </mapping>
          </completedMappings>
          <resourcing>
            <offer initiator="user" />
            <allocate initiator="user" />
            <start initiator="user" />
          </resourcing>
          <decomposesTo id="Input_position_name" />
        </task>
        <task id="DirectReports_codelet">
          <name>DirectReports codelet</name>
          <flowsInto>
            <nextElementRef id="Show_userids" />
          </flowsInto>
          <join code="xor" />
          <split code="and" />
          <startingMappings>
            <mapping>
              <expression query="&lt;positionname&gt;{/Net/positionname/text()}&lt;/positionname&gt;" />
              <mapsTo>positionname</mapsTo>
            </mapping>
          </startingMappings>
          <completedMappings>
            <mapping>
              <expression query="&lt;directreportids&gt;{/DirectReports_codelet/directreportids/text()}&lt;/directreportids&gt;" />
              <mapsTo>directreportids</mapsTo>
            </mapping>
          </completedMappings>
          <resourcing>
            <offer initiator="user" />
            <allocate initiator="user" />
            <start initiator="user" />
          </resourcing>
          <decomposesTo id="DirectReports_codelet" />
        </task>
        <task id="Show_userids">
          <name>Show userids</name>
          <flowsInto>
            <nextElementRef id="OutputCondition" />
          </flowsInto>
          <join code="xor" />
          <split code="and" />
          <startingMappings>
            <mapping>
              <expression query="&lt;directreportids&gt;{/Net/directreportids/text()}&lt;/directreportids&gt;" />
              <mapsTo>directreportids</mapsTo>
            </mapping>
            <mapping>
              <expression query="&lt;positionname&gt;{/Net/positionname/text()}&lt;/positionname&gt;" />
              <mapsTo>positionname</mapsTo>
            </mapping>
          </startingMappings>
          <resourcing>
            <offer initiator="system">
              <distributionSet>
                <initialSet />
              </distributionSet>
              <familiarParticipant taskID="Input_position_name" />
            </offer>
            <allocate initiator="system">
              <allocator>
                <name>RandomChoice</name>
              </allocator>
            </allocate>
            <start initiator="user" />
          </resourcing>
          <decomposesTo id="Show_userids" />
        </task>
        <outputCondition id="OutputCondition" />
      </processControlElements>
    </decomposition>
    <decomposition id="DirectReports_codelet" xsi:type="WebServiceGatewayFactsType">
      <name>DirectReports codelet</name>
      <inputParam>
        <index>0</index>
        <name>positionname</name>
        <type>string</type>
        <namespace>http://www.w3.org/2001/XMLSchema</namespace>
      </inputParam>
      <outputParam>
        <index>1</index>
        <name>directreportids</name>
        <type>string</type>
        <namespace>http://www.w3.org/2001/XMLSchema</namespace>
      </outputParam>
      <codelet>org.yawlfoundation.yawl.resourcing.codelets.DirectReports</codelet>
      <externalInteraction>automated</externalInteraction>
    </decomposition>
    <decomposition id="Input_position_name" xsi:type="WebServiceGatewayFactsType">
      <name>Input position name</name>
      <outputParam>
        <index>0</index>
        <name>positionname</name>
        <type>string</type>
        <namespace>http://www.w3.org/2001/XMLSchema</namespace>
        <defaultValue />
      </outputParam>
      <externalInteraction>manual</externalInteraction>
    </decomposition>
    <decomposition id="Show_userids" xsi:type="WebServiceGatewayFactsType">
      <name>Show userids</name>
      <inputParam>
        <index>0</index>
        <name>positionname</name>
        <type>string</type>
        <namespace>http://www.w3.org/2001/XMLSchema</namespace>
      </inputParam>
      <inputParam>
        <index>1</index>
        <name>directreportids</name>
        <type>string</type>
        <namespace>http://www.w3.org/2001/XMLSchema</namespace>
      </inputParam>
      <externalInteraction>manual</externalInteraction>
    </decomposition>
  </specification>
  <layout>
    <locale language="en" country="GB"/>
    <specification id="DirectReports" defaultBgColor="-526351">
      <size w="58" h="28"/>
      <net id="Net">
        <bounds x="0" y="0" w="1685" h="829"/>
        <frame x="0" y="0" w="1688" h="832"/>
        <viewport x="0" y="0" w="1688" h="832"/>
        <vertex id="OutputCondition">
          <attributes>
            <bounds x="532" y="148" w="32" h="32"/>
          </attributes>
        </vertex>
        <vertex id="InputCondition">
          <attributes>
            <bounds x="36" y="148" w="32" h="32"/>
          </attributes>
        </vertex>
        <container id="Input_position_name">
          <vertex>
            <attributes>
              <bounds x="144" y="148" w="32" h="32"/>
            </attributes>
          </vertex>
          <label>
            <attributes>
              <bounds x="112" y="180" w="96" h="28"/>
            </attributes>
          </label>
        </container>
        <container id="Show_userids">
          <vertex>
            <attributes>
              <bounds x="420" y="148" w="32" h="32"/>
            </attributes>
          </vertex>
          <label>
            <attributes>
              <bounds x="388" y="180" w="96" h="14"/>
            </attributes>
          </label>
        </container>
        <container id="DirectReports_codelet">
          <vertex>
            <attributes>
              <bounds x="276" y="148" w="32" h="32"/>
            </attributes>
          </vertex>
          <label>
            <attributes>
              <bounds x="244" y="180" w="96" h="28"/>
            </attributes>
          </label>
        </container>
        <flow source="Show_userids" target="OutputCondition">
          <ports in="13" out="12"/>
          <attributes>
            <lineStyle>11</lineStyle>
            <points>
              <value x="451" y="159.5"/>
              <value x="532" y="159.5"/>
            </points>
          </attributes>
        </flow>
        <flow source="Input_position_name" target="DirectReports_codelet">
          <ports in="13" out="12"/>
          <attributes>
            <lineStyle>11</lineStyle>
            <points>
              <value x="175" y="159.5"/>
              <value x="276" y="159.5"/>
            </points>
          </attributes>
        </flow>
        <flow source="InputCondition" target="Input_position_name">
          <ports in="13" out="12"/>
          <attributes>
            <lineStyle>11</lineStyle>
            <points>
              <value x="67" y="159.5"/>
              <value x="144" y="159.5"/>
            </points>
          </attributes>
        </flow>
        <flow source="DirectReports_codelet" target="Show_userids">
          <ports in="13" out="12"/>
          <attributes>
            <lineStyle>11</lineStyle>
            <points>
              <value x="307" y="159.5"/>
              <value x="420" y="159.5"/>
            </points>
          </attributes>
        </flow>
      </net>
      <labelFontSize>12</labelFontSize>
    </specification>
  </layout>
</specificationSet>
