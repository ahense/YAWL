          <resourcing>
            <offer initiator="user" />
            <allocate initiator="user" />
            <start initiator="user" />
          </resourcing>
          <decomposesTo id="Input_position_name" />
        </task>
        <task id="ParticipantInfo_codelet">
          <name>ParticipantInfo codelet</name>
