            </mapping>
            <mapping>
              <expression query="&lt;emailOnAllocation&gt;{/Net/emailOnAllocation/text()}&lt;/emailOnAllocation&gt;" />
              <mapsTo>emailOnAllocation</mapsTo>
            </mapping>
            <mapping>
              <expression query="&lt;fullname&gt;{/Net/fullname/text()}&lt;/fullname&gt;" />
              <mapsTo>fullname</mapsTo>
            </mapping>
            <mapping>
              <expression query="&lt;isAdministrator&gt;{/Net/isAdministrator/text()}&lt;/isAdministrator&gt;" />
