            </mapping>
            <mapping>
              <expression query="&lt;userid&gt;{/Net/userid/text()}&lt;/userid&gt;" />
              <mapsTo>userid</mapsTo>
            </mapping>
            <mapping>
              <expression query="&lt;lastname&gt;{/Net/lastname/text()}&lt;/lastname&gt;" />
              <mapsTo>lastname</mapsTo>
            </mapping>
            <mapping>
              <expression query="&lt;delimiter&gt;{/Net/delimiter/text()}&lt;/delimiter&gt;" />
