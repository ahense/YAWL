              <bounds x="280" y="88" w="32" h="32"/>
            </attributes>
          </vertex>
          <label>
            <attributes>
              <bounds x="248" y="120" w="96" h="28"/>
            </attributes>
          </label>
        </container>
        <container id="Input_position_name">
          <vertex>
