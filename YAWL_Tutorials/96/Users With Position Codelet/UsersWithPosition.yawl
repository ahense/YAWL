<?xml version="1.0" encoding="UTF-8"?>
<specificationSet xmlns="http://www.yawlfoundation.org/yawlschema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" version="4.0" xsi:schemaLocation="http://www.yawlfoundation.org/yawlschema http://www.yawlfoundation.org/yawlschema/YAWL_Schema4.0.xsd">
  <specification uri="UsersWithPosition">
    <name>UsersWithRoles</name>
    <documentation>used to test the users with position codelet</documentation>
    <metaData>
      <title>UsersWithPosition</title>
      <creator>AVH</creator>
      <description>used to test the users with position codelet</description>
      <coverage>5.2.821</coverage>
      <version>0.1</version>
      <persistent>false</persistent>
      <identifier>UID_b301d1a5-9311-4d9e-99f1-cfa255ae3fd9</identifier>
    </metaData>
    <xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" />
    <decomposition id="Net" isRootNet="true" xsi:type="NetFactsType">
      <localVariable>
        <index>0</index>
        <name>userids</name>
        <type>string</type>
        <namespace>http://www.w3.org/2001/XMLSchema</namespace>
        <initialValue />
      </localVariable>
      <localVariable>
        <index>1</index>
        <name>positionname</name>
        <type>string</type>
        <namespace>http://www.w3.org/2001/XMLSchema</namespace>
        <initialValue />
      </localVariable>
      <processControlElements>
        <inputCondition id="InputCondition">
          <flowsInto>
            <nextElementRef id="Input_position_name" />
          </flowsInto>
        </inputCondition>
        <task id="Input_position_name">
          <name>Input position name</name>
          <flowsInto>
            <nextElementRef id="Users_with_positions_codelet" />
          </flowsInto>
          <join code="xor" />
          <split code="and" />
          <completedMappings>
            <mapping>
              <expression query="&lt;positionname&gt;{/Input_position_name/positionname/text()}&lt;/positionname&gt;" />
              <mapsTo>positionname</mapsTo>
            </mapping>
          </completedMappings>
          <resourcing>
            <offer initiator="user" />
            <allocate initiator="user" />
            <start initiator="user" />
          </resourcing>
          <decomposesTo id="Input_position_name" />
        </task>
        <task id="Users_with_positions_codelet">
          <name>Users with positions codelet</name>
          <flowsInto>
            <nextElementRef id="Show_userids" />
          </flowsInto>
          <join code="xor" />
          <split code="and" />
          <startingMappings>
            <mapping>
              <expression query="&lt;positionname&gt;{/Net/positionname/text()}&lt;/positionname&gt;" />
              <mapsTo>positionname</mapsTo>
            </mapping>
          </startingMappings>
          <completedMappings>
            <mapping>
              <expression query="&lt;userids&gt;{/Users_with_positions_codelet/userids/text()}&lt;/userids&gt;" />
              <mapsTo>userids</mapsTo>
            </mapping>
          </completedMappings>
          <resourcing>
            <offer initiator="user" />
            <allocate initiator="user" />
            <start initiator="user" />
          </resourcing>
          <decomposesTo id="Users_with_positions_codelet" />
        </task>
        <task id="Show_userids">
          <name>Show userids</name>
          <flowsInto>
            <nextElementRef id="OutputCondition" />
          </flowsInto>
          <join code="xor" />
          <split code="and" />
          <startingMappings>
            <mapping>
              <expression query="&lt;userids&gt;{/Net/userids/text()}&lt;/userids&gt;" />
              <mapsTo>userids</mapsTo>
            </mapping>
            <mapping>
              <expression query="&lt;positionname&gt;{/Net/positionname/text()}&lt;/positionname&gt;" />
              <mapsTo>positionname</mapsTo>
            </mapping>
          </startingMappings>
          <resourcing>
            <offer initiator="system">
              <distributionSet>
                <initialSet />
              </distributionSet>
              <familiarParticipant taskID="Input_position_name" />
            </offer>
            <allocate initiator="system">
              <allocator>
                <name>RandomChoice</name>
              </allocator>
            </allocate>
            <start initiator="user" />
          </resourcing>
          <decomposesTo id="Show_userids" />
        </task>
        <outputCondition id="OutputCondition" />
      </processControlElements>
    </decomposition>
    <decomposition id="Input_position_name" xsi:type="WebServiceGatewayFactsType">
      <name>Input position name</name>
      <outputParam>
        <index>0</index>
        <name>positionname</name>
        <type>string</type>
        <namespace>http://www.w3.org/2001/XMLSchema</namespace>
        <defaultValue />
      </outputParam>
      <externalInteraction>manual</externalInteraction>
    </decomposition>
    <decomposition id="Show_userids" xsi:type="WebServiceGatewayFactsType">
      <name>Show userids</name>
      <inputParam>
        <index>0</index>
        <name>positionname</name>
        <type>string</type>
        <namespace>http://www.w3.org/2001/XMLSchema</namespace>
      </inputParam>
      <inputParam textarea="true">
        <index>1</index>
        <name>userids</name>
        <type>string</type>
        <namespace>http://www.w3.org/2001/XMLSchema</namespace>
      </inputParam>
      <externalInteraction>manual</externalInteraction>
    </decomposition>
    <decomposition id="Users_with_positions_codelet" xsi:type="WebServiceGatewayFactsType">
      <name>Users with positions codelet</name>
      <inputParam>
        <index>0</index>
        <name>positionname</name>
        <type>string</type>
        <namespace>http://www.w3.org/2001/XMLSchema</namespace>
      </inputParam>
      <outputParam>
        <index>1</index>
        <name>userids</name>
        <type>string</type>
        <namespace>http://www.w3.org/2001/XMLSchema</namespace>
      </outputParam>
      <codelet>org.yawlfoundation.yawl.resourcing.codelets.UsersWithPosition</codelet>
      <externalInteraction>automated</externalInteraction>
    </decomposition>
  </specification>
  <layout>
    <locale language="en" country="GB"/>
    <specification id="UsersWithPosition" defaultBgColor="-526351">
