      <processControlElements>
        <inputCondition id="InputCondition">
          <flowsInto>
            <nextElementRef id="Input_position_name" />
          </flowsInto>
        </inputCondition>
        <task id="Input_position_name">
          <name>Input position name</name>
          <flowsInto>
            <nextElementRef id="ParticipantInfo_codelet" />
          </flowsInto>
          <join code="xor" />
          <split code="and" />
          <completedMappings>
            <mapping>
              <expression query="&lt;userid&gt;{/Input_position_name/userid/text()}&lt;/userid&gt;" />
              <mapsTo>userid</mapsTo>
            </mapping>
            <mapping>
              <expression query="&lt;delimiter&gt;{/Input_position_name/delimiter/text()}&lt;/delimiter&gt;" />
              <mapsTo>delimiter</mapsTo>
