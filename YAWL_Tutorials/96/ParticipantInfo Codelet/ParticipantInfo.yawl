          <resourcing>
            <offer initiator="user" />
            <allocate initiator="user" />
            <start initiator="user" />
          </resourcing>
          <decomposesTo id="Participantinfo_codelet" />
        </task>
        <task id="Show_info">
          <name>Show info</name>
          <flowsInto>
            <nextElementRef id="OutputCondition" />
          </flowsInto>
          <join code="xor" />
          <split code="and" />
          <startingMappings>
            <mapping>
              <expression query="&lt;firstname&gt;{/Net/firstname/text()}&lt;/firstname&gt;" />
              <mapsTo>firstname</mapsTo>
            </mapping>
            <mapping>
